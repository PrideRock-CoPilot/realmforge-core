//! Multi-file repository support (DDR-003).
//!
//! Implements segment rotation, manifest management, and multi-file read/write
//! operations for repositories larger than 1.5 GB.

use std::path::{Path, PathBuf};

use chrono::Utc;
use rfsource_format::{
    append_frame, detect_repository_mode, get_file_size, initialize, manifest_path,
    read_frames, segment_path, single_file_path, Manifest, RepositoryMode, SegmentInfo,
    SEGMENT_SIZE_THRESHOLD,
};
use serde::Serialize;

use crate::error::{Result, StoreError};

/// Multi-file repository manager.
///
/// Handles segment rotation, manifest updates, and multi-file operations.
pub struct MultiFileRepo {
    repo_dir: PathBuf,
    manifest: Manifest,
}

impl MultiFileRepo {
    /// Open or initialize a multi-file repository.
    ///
    /// If manifest doesn't exist, initializes it with segment 0.
    pub fn open_or_init(repo_dir: impl Into<PathBuf>) -> Result<Self> {
        let repo_dir = repo_dir.into();
        let manifest_file = manifest_path(&repo_dir);

        let mut manifest = if manifest_file.exists() {
            Manifest::load(&manifest_file)?
        } else {
            // Initialize new multi-file repo
            let mut m = Manifest::new();
            let seg0 = SegmentInfo::new(0, 0);
            let seg0_path = seg0.full_path(&repo_dir);
            initialize(&seg0_path)?;
            m.segments.push(seg0);
            m.save(&manifest_file)?;
            m
        };

        // Ensure active segment is tracked
        if manifest.active_segment().is_none() && !manifest.segments.is_empty() {
            let last_idx = manifest.segments.len() - 1;
            manifest.segments[last_idx].closed_at = None;
        }

        Ok(Self {
            repo_dir,
            manifest,
        })
    }

    /// Get the active segment path.
    pub fn active_segment_path(&self) -> Result<PathBuf> {
        let seg = self
            .manifest
            .active_segment()
            .ok_or_else(|| StoreError::Internal("No active segment".to_string()))?;
        Ok(seg.full_path(&self.repo_dir))
    }

    /// Append a frame to the active segment, rotating if needed.
    ///
    /// ## Algorithm
    ///
    /// 1. Check active segment size
    /// 2. If >= 1 GB, rotate to new segment
    /// 3. Append frame to active segment
    /// 4. Update manifest
    pub fn append_frame<T: Serialize>(&mut self, value: &T) -> Result<()> {
        // Check if rotation needed
        if self.should_rotate()? {
            self.rotate_segment()?;
        }

        // Append to active segment
        let seg_path = self.active_segment_path()?;
        append_frame(&seg_path, value)?;

        // Update segment size tracking
        let new_size = get_file_size(&seg_path)?;
        if let Some(active) = self.manifest.active_segment_mut() {
            active.size_bytes = new_size;
            active.frame_count += 1;
            active.last_frame_id += 1;
            self.manifest.total_frames += 1;
            self.manifest.total_size_bytes = self
                .manifest
                .segments
                .iter()
                .map(|s| s.size_bytes)
                .sum();
        }

        // Save manifest
        self.save_manifest()?;

        Ok(())
    }

    /// Append multiple frames, rotating as needed.
    pub fn append_frames<T: Serialize>(&mut self, values: &[T]) -> Result<()> {
        for value in values {
            self.append_frame(value)?;
        }
        Ok(())
    }

    /// Check if active segment should be rotated.
    fn should_rotate(&self) -> Result<bool> {
        let active = self
            .manifest
            .active_segment()
            .ok_or_else(|| StoreError::Internal("No active segment".to_string()))?;

        let seg_path = active.full_path(&self.repo_dir);
        let size = get_file_size(&seg_path)?;

        Ok(size >= SEGMENT_SIZE_THRESHOLD)
    }

    /// Rotate to a new segment.
    ///
    /// ## Algorithm
    ///
    /// 1. Close current active segment (set closed_at)
    /// 2. Calculate next frame ID
    /// 3. Create new segment file
    /// 4. Add new segment to manifest
    /// 5. Save manifest atomically
    fn rotate_segment(&mut self) -> Result<()> {
        // Close current segment
        let next_frame_id = if let Some(active) = self.manifest.active_segment_mut() {
            active.closed_at = Some(Utc::now());
            active.last_frame_id + 1
        } else {
            return Err(StoreError::Internal("No active segment to close".to_string()));
        };

        // Create new segment
        let next_index = self.manifest.next_segment_index();
        let new_seg = SegmentInfo::new(next_index, next_frame_id);
        let new_seg_path = new_seg.full_path(&self.repo_dir);

        // Initialize segment file
        initialize(&new_seg_path)?;

        // Add to manifest
        self.manifest.segments.push(new_seg);

        // Save manifest
        self.save_manifest()?;

        Ok(())
    }

    /// Read all frames from all segments in order.
    pub fn read_all_frames<T: serde::de::DeserializeOwned>(&self) -> Result<Vec<T>> {
        let mut all_frames = Vec::new();

        for segment in &self.manifest.segments {
            let seg_path = segment.full_path(&self.repo_dir);
            let frames: Vec<T> = read_frames(&seg_path)?;
            all_frames.extend(frames);
        }

        Ok(all_frames)
    }

    /// Read frames from specific segments.
    pub fn read_frames_from_segments<T: serde::de::DeserializeOwned>(
        &self,
        segment_indices: &[u32],
    ) -> Result<Vec<T>> {
        let mut frames = Vec::new();

        for &idx in segment_indices {
            if let Some(segment) = self.manifest.segments.iter().find(|s| s.index == idx) {
                let seg_path = segment.full_path(&self.repo_dir);
                let seg_frames: Vec<T> = read_frames(&seg_path)?;
                frames.extend(seg_frames);
            }
        }

        Ok(frames)
    }

    // ============================================================================
    // Day 3.1: Query Routing with Frame Ranges
    // ============================================================================

    /// Find which segment contains a specific frame ID (O(log N) binary search).
    ///
    /// Returns the segment index, or None if the frame ID is out of bounds.
    ///
    /// ## Algorithm
    ///
    /// Binary search on segments using first_frame_id and last_frame_id ranges.
    pub fn find_segment_for_frame_id(&self, frame_id: u64) -> Option<u32> {
        // Binary search for the segment containing frame_id
        let mut left = 0;
        let mut right = self.manifest.segments.len();

        while left < right {
            let mid = left + (right - left) / 2;
            let segment = &self.manifest.segments[mid];

            if frame_id < segment.first_frame_id {
                right = mid;
            } else if frame_id > segment.last_frame_id {
                left = mid + 1;
            } else {
                // Found: frame_id is in [first_frame_id, last_frame_id]
                return Some(segment.index);
            }
        }

        None
    }

    /// Find all segments that overlap with a frame range [start_id, end_id] inclusive.
    ///
    /// Returns segment indices in ascending order.
    ///
    /// ## Algorithm
    ///
    /// 1. Use binary search to find the first segment that might contain start_id
    /// 2. Iterate forward until we pass end_id
    pub fn find_segments_for_frame_range(&self, start_id: u64, end_id: u64) -> Vec<u32> {
        if start_id > end_id {
            return Vec::new();
        }

        let mut result = Vec::new();

        // Find first segment that might contain frames >= start_id
        let first_seg_idx = self
            .manifest
            .segments
            .iter()
            .position(|seg| seg.last_frame_id >= start_id);

        if let Some(start_idx) = first_seg_idx {
            // Collect segments until we pass end_id
            for segment in &self.manifest.segments[start_idx..] {
                // Segment overlaps if: segment.first <= end_id AND segment.last >= start_id
                if segment.first_frame_id <= end_id && segment.last_frame_id >= start_id {
                    result.push(segment.index);
                } else if segment.first_frame_id > end_id {
                    // Past the range, stop
                    break;
                }
            }
        }

        result
    }

    /// Read frames within a specific frame ID range [start_id, end_id] inclusive.
    ///
    /// Only reads from segments that contain frames in this range, avoiding
    /// unnecessary I/O on irrelevant segments.
    ///
    /// ## Algorithm
    ///
    /// 1. Find relevant segments using find_segments_for_frame_range
    /// 2. Read frames from those segments
    /// 3. Filter frames to only include those with IDs in [start_id, end_id]
    ///
    /// ## Note
    ///
    /// This assumes frames have an `id` or similar field to filter on.
    /// For generic frame types without IDs, this returns all frames from
    /// the relevant segments.
    pub fn read_frame_range<T: serde::de::DeserializeOwned>(
        &self,
        start_id: u64,
        end_id: u64,
    ) -> Result<Vec<T>> {
        let segment_indices = self.find_segments_for_frame_range(start_id, end_id);

        if segment_indices.is_empty() {
            return Ok(Vec::new());
        }

        // Read frames from relevant segments
        self.read_frames_from_segments(&segment_indices)

        // Note: Actual frame-level filtering would require inspecting frame
        // contents, which depends on the frame schema. For now, we return all
        // frames from relevant segments. Caller can filter further if needed.
    }

    /// Get the manifest.
    pub fn manifest(&self) -> &Manifest {
        &self.manifest
    }

    /// Save manifest to disk.
    fn save_manifest(&self) -> Result<()> {
        let manifest_file = manifest_path(&self.repo_dir);
        self.manifest.save(&manifest_file)?;
        Ok(())
    }
}

/// Detect repository mode and return appropriate path(s).
pub fn detect_mode(repo_path: &Path) -> (RepositoryMode, PathBuf) {
    let mode = detect_repository_mode(repo_path);
    let path = match mode {
        RepositoryMode::SingleFile => single_file_path(repo_path),
        RepositoryMode::MultiFile => manifest_path(repo_path),
    };
    (mode, path)
}

/// Migrate a single-file repository to multi-file format.
///
/// ## Algorithm
///
/// 1. Read all frames from single file
/// 2. Create multi-file repo with segment 0
/// 3. Write all frames to segment 0
/// 4. Create manifest
/// 5. Rename original file to `.rfsource.backup`
pub fn migrate_to_multi_file<T>(repo_dir: &Path) -> Result<()>
where
    T: Serialize + serde::de::DeserializeOwned,
{
    let single_file = single_file_path(repo_dir);
    if !single_file.exists() {
        return Err(StoreError::NotFound(single_file));
    }

    // Read all frames
    let frames: Vec<T> = read_frames(&single_file)?;

    // Create multi-file repo
    let mut multi_repo = MultiFileRepo::open_or_init(repo_dir)?;

    // Write frames to segment 0
    multi_repo.append_frames(&frames)?;

    // Backup original file
    let backup_path = single_file.with_extension("rfsource.backup");
    std::fs::rename(&single_file, &backup_path)?;

    Ok(())
}

#[cfg(test)]
mod tests {
    use super::*;
    use serde::{Deserialize, Serialize};
    use tempfile::tempdir;

    #[derive(Debug, Serialize, Deserialize, PartialEq)]
    struct TestFrame {
        id: u32,
        data: String,
    }

    #[test]
    fn test_multi_file_repo_init() {
        let dir = tempdir().unwrap();
        let repo = MultiFileRepo::open_or_init(dir.path()).unwrap();

        assert_eq!(repo.manifest.segments.len(), 1);
        assert_eq!(repo.manifest.segments[0].index, 0);
        assert!(repo.manifest.active_segment().is_some());
    }

    #[test]
    fn test_append_frame() {
        let dir = tempdir().unwrap();
        let mut repo = MultiFileRepo::open_or_init(dir.path()).unwrap();

        let frame = TestFrame {
            id: 1,
            data: "test".to_string(),
        };

        repo.append_frame(&frame).unwrap();

        assert_eq!(repo.manifest.total_frames, 1);
        assert!(repo.manifest.active_segment().unwrap().frame_count == 1);
    }

    #[test]
    fn test_read_all_frames() {
        let dir = tempdir().unwrap();
        let mut repo = MultiFileRepo::open_or_init(dir.path()).unwrap();

        let frames = vec![
            TestFrame {
                id: 1,
                data: "first".to_string(),
            },
            TestFrame {
                id: 2,
                data: "second".to_string(),
            },
        ];

        repo.append_frames(&frames).unwrap();

        let read_frames: Vec<TestFrame> = repo.read_all_frames().unwrap();
        assert_eq!(read_frames.len(), 2);
        assert_eq!(read_frames[0].id, 1);
        assert_eq!(read_frames[1].id, 2);
    }

    // ============================================================================
    // Day 3.1: Query Routing Tests
    // ============================================================================

    #[test]
    fn test_find_segment_for_frame_id() {
        let dir = tempdir().unwrap();
        let mut repo = MultiFileRepo::open_or_init(dir.path()).unwrap();

        // Add frames to establish frame ranges
        let frames: Vec<TestFrame> = (0..10)
            .map(|i| TestFrame {
                id: i,
                data: format!("frame_{}", i),
            })
            .collect();

        repo.append_frames(&frames).unwrap();

        // Test finding frames
        assert_eq!(repo.find_segment_for_frame_id(0), Some(0));
        assert_eq!(repo.find_segment_for_frame_id(5), Some(0));
        assert_eq!(repo.find_segment_for_frame_id(9), Some(0));

        // Out of bounds
        assert_eq!(repo.find_segment_for_frame_id(1000), None);
    }

    #[test]
    fn test_find_segments_for_frame_range() {
        let dir = tempdir().unwrap();
        let mut repo = MultiFileRepo::open_or_init(dir.path()).unwrap();

        // Add frames
        let frames: Vec<TestFrame> = (0..20)
            .map(|i| TestFrame {
                id: i,
                data: format!("frame_{}", i),
            })
            .collect();

        repo.append_frames(&frames).unwrap();

        // Test range queries
        let segments = repo.find_segments_for_frame_range(0, 10);
        assert!(!segments.is_empty());
        assert!(segments.contains(&0));

        // Full range
        let segments = repo.find_segments_for_frame_range(0, 19);
        assert!(!segments.is_empty());

        // Out of bounds range
        let segments = repo.find_segments_for_frame_range(1000, 2000);
        assert!(segments.is_empty());

        // Invalid range (start > end)
        let segments = repo.find_segments_for_frame_range(10, 5);
        assert!(segments.is_empty());
    }

    #[test]
    fn test_read_frame_range() {
        let dir = tempdir().unwrap();
        let mut repo = MultiFileRepo::open_or_init(dir.path()).unwrap();

        // Add frames
        let frames: Vec<TestFrame> = (0..15)
            .map(|i| TestFrame {
                id: i,
                data: format!("frame_{}", i),
            })
            .collect();

        repo.append_frames(&frames).unwrap();

        // Read range
        let read_frames: Vec<TestFrame> = repo.read_frame_range(0, 10).unwrap();
        assert!(!read_frames.is_empty());
        // Note: Without frame-level filtering, we get all frames from relevant segments

        // Read full range
        let read_frames: Vec<TestFrame> = repo.read_frame_range(0, 14).unwrap();
        assert_eq!(read_frames.len(), 15);

        // Read out of bounds
        let read_frames: Vec<TestFrame> = repo.read_frame_range(1000, 2000).unwrap();
        assert!(read_frames.is_empty());
    }
}
