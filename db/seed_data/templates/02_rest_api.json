          "add_modules": ["relational_db", "orm", "migrations"],
          "add_personas": ["backend", "data-architect"]
        },
        {
          "value": "documents",
          "label": "Document data - JSON, flexible schemas",
          "add_modules": ["document_db", "json_validation"],
          "add_personas": ["backend"]
        },
        {
          "value": "files",
          "label": "File uploads - Images, documents, media",
          "add_modules": ["object_store", "file_upload", "cdn"],
          "add_personas": ["backend", "devops"]
        },
        {
          "value": "cache",
          "label": "Cached data - Session state, frequently accessed data",
          "add_modules": ["redis", "caching_layer"],
          "add_personas": ["backend"]
