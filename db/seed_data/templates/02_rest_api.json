  "questions": [
    {
      "id": "q1_auth",
      "text": "Does your API require authentication?",
      "type": "boolean",
      "help_text": "Authentication controls who can access your API endpoints.",
      "default": true,
      "validation": {
        "required": true
      },
      "on_true": {
        "add_modules": ["authentication", "session_management"],
        "add_personas": ["backend", "security-architect"],
        "next_question": "q2_auth_type"
      },
      "on_false": {
        "next_question": "q3_data_storage"
      }
    },
    {
      "id": "q2_auth_type",
      "text": "What authentication method do you need?",
      "type": "multi_select",
      "help_text": "You can select multiple authentication methods.",
      "show_if": {
        "question": "q1_auth",
        "equals": true
      },
      "options": [
        {
          "value": "api_key",
          "label": "API Keys - Simple token-based auth",
          "add_modules": ["api_key_management"],
          "add_personas": ["backend"]
        },
        {
          "value": "jwt",
          "label": "JWT Tokens - Stateless authentication",
          "add_modules": ["jwt_auth", "token_refresh"],
          "add_personas": ["backend"]
        },
        {
          "value": "oauth2",
          "label": "OAuth 2.0 - Third-party authentication",
          "add_modules": ["oauth_provider", "oauth_client"],
          "add_personas": ["backend", "security-architect"]
        },
        {
          "value": "basic",
          "label": "Basic Auth - Username/password (not recommended for production)",
          "add_modules": ["basic_auth"],
          "add_personas": ["backend"]
        }
      ],
      "validation": {
        "required": true,
        "min_selections": 1
      },
      "next_question": "q3_data_storage"
    },
    {
